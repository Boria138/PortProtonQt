{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "rebaseWhen": "never",

  "lockFileMaintenance": {
    "enabled": true
  },

  "pre-commit": {
    "enabled": false
  },

  "packageRules": [
    {
      "description": "Update renovate only weekly",
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "extends": ["schedule:weekly"]
    },
    {
      "description": "Automerge renovate updates",
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge safe minor/patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Disable updates for broken workflows",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".gitea/workflows/build.yml",
        ".gitea/workflows/build-vk-gpu-info-debian.yml"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [".python-version"],
      "enabled": false
    },
    {
      "matchManagers": ["poetry", "pyenv"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump",
      "versioning": "pep440",
      "groupName": "Python dependencies"
    },
    {
      "description": "We use meson",
      "matchPackageNames": ["setuptools"],
      "enabled": false
    },
    {
      "matchDatasources": ["github-runners", "python-version"],
      "enabled": false,
      "description": "Prevent Renovate from updating runs-on to unsupported ubuntu-24.04"
    }
  ],

  "hostRules": [
    {
      "description": "Make renovate know this is a gitea compatible host",
      "matchHost": "git.linux-gaming.ru",
      "hostType": "gitea",
      "maxRequestsPerSecond": 8
    }
  ],

  "prConcurrentLimit": 3
}
