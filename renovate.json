{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "rebaseWhen": "never",
  "fetchChangeLogs": "off",
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Update Renovate image only weekly",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "extends": [
        "schedule:weekly"
      ]
    },
    {
      "description": "Disable updates for broken workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".gitea/workflows/build.yml",
        ".gitea/workflows/build-vk-gpu-info-debian.yml"
      ],
      "enabled": false
    },
    {
      "description": "Disable poetry and pyenv managers",
      "matchManagers": [
        "poetry",
        "pyenv"
      ],
      "enabled": false
    },
    {
      "description": "Group PEP 621 Python dependencies",
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "bump",
      "versioning": "pep440",
      "groupName": "Python dependencies"
    },
    {
      "description": "Project uses meson, not setuptools",
      "matchPackageNames": [
        "setuptools"
      ],
      "enabled": false
    },
    {
      "description": "Prevent unsupported runner and Python version updates",
      "matchDatasources": [
        "github-runners",
        "python-version"
      ],
      "enabled": false
    }
  ]
}
