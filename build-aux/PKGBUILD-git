pkgname=('portprotonqt-git' 'portprotonqt-git-steam-compat')
pkgver=.
pkgrel=1
pkgdesc="Modern GUI for managing and launching games from PortProton, Steam, and Epic Games Store (development build)"
arch=('any')
url="https://git.linux-gaming.ru/Boria138/PortProtonQt"
license=('GPL-3.0')
depends=('python-requests' 'python-babel' 'python-evdev' 'python-pyudev' 'python-orjson'
    'python-psutil' 'python-tqdm' 'python-vdf' 'python-libarchive-c' 'pyside6' 'python-rapidfuzz' 'icoextract' 'python-pillow' 'perl-image-exiftool' 'python-beautifulsoup4' 'python-websocket-client' 'cabextract' 'unzip' 'curl' 'unrar' 'qt6-svg' 'pciutils' 'mesa-utils' 'vulkan-icd-loader')
depends_aarch64=('muvm')
makedepends=('meson' 'ninja' 'vulkan-headers')
source=("git+https://git.linux-gaming.ru/Boria138/PortProtonQt.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/PortProtonQt"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    arch-meson PortProtonQt build
    meson compile -C build
}

package_portprotonqt-git() {
    pkgdesc="Modern GUI for managing and launching games from PortProton, Steam, and Epic Games Store (development build)"
    depends+=('portprotonqt-git-steam-compat')

    DESTDIR="$pkgdir" meson install -C build --skip-subprojects

    # Remove steam-compat files from main package
    rm -rf "$pkgdir/usr/share/steam"
}

package_portprotonqt-git-steam-compat() {
    pkgdesc="Steam compatibility tool for PortProtonQt (development build)"
    depends=('portprotonqt-git')

    DESTDIR="$pkgdir" meson install -C build --skip-subprojects

    # Keep only steam-compat files
    rm -rf "$pkgdir/usr/bin"
    rm -rf "$pkgdir/usr/lib"
    rm -rf "$pkgdir/usr/share/applications"
    rm -rf "$pkgdir/usr/share/bash-completion"
    rm -rf "$pkgdir/usr/share/icons"
    rm -rf "$pkgdir/usr/share/metainfo"
    rm -rf "$pkgdir/usr/lib/udev"
    rm -rf "$pkgdir/usr/share/portprotonqt"
}
